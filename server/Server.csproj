<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.10.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
  </ItemGroup>

    <!-- בפרסום (dotnet publish): בונים את האתר ומכניסים אותו ל־wwwroot -->
  <PropertyGroup>
    <ClientRoot>..\client\</ClientRoot>
  </PropertyGroup>

  <Target Name="PublishClient" AfterTargets="ComputeFilesToPublish">
    <Exec WorkingDirectory="$(ClientRoot)" Command="npm ci" />
    <Exec WorkingDirectory="$(ClientRoot)" Command="npm run build" />

    <ItemGroup>
      <ClientDistFiles Include="$(ClientRoot)dist\client\browser\**" />
      <ResolvedFileToPublish Include="@(ClientDistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(FileName)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>

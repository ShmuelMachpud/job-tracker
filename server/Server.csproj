<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>1e028076-4b94-4c22-a3e9-ee321df3d8a8</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.10.5" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.4" />
  </ItemGroup>

    <!-- בפרסום (dotnet publish): בונים את האתר ומכניסים אותו ל־wwwroot -->
  <PropertyGroup>
    <ClientRoot>..\client\</ClientRoot>
  </PropertyGroup>

  <Target Name="PublishClient" AfterTargets="ComputeFilesToPublish">
    <!-- ב־Docker האתר נבנה בשלב נפרד, ולכן שם מדלגים עם -p:SkipClientBuild=true -->
    <Exec Condition="'$(SkipClientBuild)' != 'true'" WorkingDirectory="$(ClientRoot)" Command="npm ci" />
    <Exec Condition="'$(SkipClientBuild)' != 'true'" WorkingDirectory="$(ClientRoot)" Command="npm run build" />

    <ItemGroup>
      <ClientDistFiles Include="$(ClientRoot)dist\client\browser\**" />
      <ResolvedFileToPublish Include="@(ClientDistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(FileName)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
